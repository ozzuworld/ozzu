# Volts local state (machine-specific, not shared)
.volts/

# Infra secrets — passwords, tokens — must NEVER enter the repo.
# Real values live in ~/.ozzu-secrets (chmod 600). See infra/secrets.example.
infra/secrets
infra/secrets.local
infra/*.secrets
.ozzu-secrets

# OpenVPN runtime files
backend/openvpn/config/ipp.txt
backend/openvpn/config/openvpn-status.log
backend/openvpn/config/*.pid

# Native module build artifacts
frontend/modules/*/android/build/

# HA runtime artifacts
backend/config/.ha_run.lock
backend/config/blueprints/
backend/config/custom_components/
backend/config/home-assistant.log.*

# Root config (HA data outside backend/)
config/

# Auto-generated Cipher context (local-only)
CLAUDE.local.md
CLAUDE.local.md.bak

# OS
.DS_Store
Thumbs.db
whatsapp-mcp/

# All .env files anywhere under backend/ — names like .env.gmail, .env.email, .env.encrypted,
# backend/bridge/.env, etc. have repeatedly leaked plaintext secrets into git history
# (5b74f1d5 committed Gmail app passwords + OctoPrint password — those values must be rotated).
# Real secret values live in ~/.ozzu-secrets (chmod 600). See infra/secrets.example.
backend/**/.env
backend/**/.env.*

# Private workspace — cucm creds, legal case files, drone secrets, evidence, etc.
# Has been UNTRACKED but unprotected against `git add private/` accidents.
private/

# Encrypted env files — never commit even if encrypted (key sits next to ciphertext on host)
backend/.env.encrypted
backend/.env.encrypted.bak

# Encrypted app backups (227 MB tar.gz.enc tarballs, canonical location per INVENTORY.md)
/backups/

# Local Dockerfile patches (per-cycle OSINT comment, machine-specific)
backend/bridge/Dockerfile.bak
backend/Dockerfile.joko

# Local docker-compose overrides
docker-compose.override.yml
backend/docker-compose.override.yml

# Python venvs (scripts/.venv-vacuum/, etc. — pip-installed deps)
scripts/.venv-*
__pycache__/
tools/gsm-gateway/android/app/build/
tools/gsm-gateway/android/.gradle/
tools/gsm-gateway/android/gradle/
