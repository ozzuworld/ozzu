[Unit]
Description=Ozzu Positioning Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ozzu-positioning
ExecStart=/usr/bin/python3 hub.py --config hub.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
