{
  "output": {
    "filePath": "../layer1/repomap.txt",
    "style": "markdown",
    "headerText": "Ozzu repo map — generated by .cipher/tools/repomix. Update via scripts/cipher-analyze.sh layer1.",
    "includeEmptyDirectories": false,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 30,
    "showLineNumbers": false
  },
  "include": [
    "frontend/app/**/*.{ts,tsx,js,jsx}",
    "frontend/components/**/*.{ts,tsx,js,jsx}",
    "frontend/lib/**/*.{ts,tsx,js,jsx}",
    "frontend/modules/**/*.{ts,tsx,js,jsx}",
    "backend/bridge/*.js",
    "backend/bridge/routes/**/*.js",
    "scripts/**/*.{sh,js,py}",
    ".claude/rules/**/*.md",
    "CLAUDE.md",
    "INVENTORY.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.expo/**",
      "**/android/**",
      "**/ios/**",
      "**/build/**",
      "**/dist/**",
      "**/coverage/**",
      "**/.cipher/**",
      "**/*.lock",
      "**/*.log"
    ]
  }
}
