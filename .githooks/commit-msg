#!/usr/bin/env bash
# Pipeline bypass detection — commit-msg hook
# Blocks commits to main without a directive ID or exception tag in the message.
# Install: git config core.hooksPath .githooks

set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# Cipher-direct and agent branches are always allowed
if [[ "$BRANCH" == cipher/* ]] || [[ "$BRANCH" == agent/* ]]; then
  exit 0
fi

# Only enforce on main
if [[ "$BRANCH" != "main" ]]; then
  exit 0
fi

COMMIT_MSG_FILE="$1"
if [[ -z "$COMMIT_MSG_FILE" || ! -f "$COMMIT_MSG_FILE" ]]; then
  exit 0
fi

COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Check for directive ID pattern (dir_)
if echo "$COMMIT_MSG" | grep -q 'dir_'; then
  exit 0
fi

# Check for exception tags
if echo "$COMMIT_MSG" | grep -qi '\[pipeline-fix\]'; then
  exit 0
fi
if echo "$COMMIT_MSG" | grep -qi '\[config\]'; then
  exit 0
fi
if echo "$COMMIT_MSG" | grep -qi '\[docs\]'; then
  exit 0
fi
if echo "$COMMIT_MSG" | grep -qi '\[security\]'; then
  exit 0
fi

# Auto-detect: only .md files staged
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || echo "")
NON_MD=$(echo "$STAGED_FILES" | grep -v '\.md$' || true)
if [[ -z "$NON_MD" ]]; then
  exit 0
fi

# Auto-detect: only .env* files staged
NON_ENV=$(echo "$STAGED_FILES" | grep -v '\.env' || true)
if [[ -z "$NON_ENV" ]]; then
  exit 0
fi

echo ""
echo "=========================================="
echo "  PIPELINE BYPASS DETECTED"
echo "=========================================="
echo ""
echo "  Commit to 'main' blocked: no directive ID or exception tag found."
echo ""
echo "  Your commit message must contain one of:"
echo "    - A directive ID (e.g., dir_1234567890)"
echo "    - [pipeline-fix] for infrastructure fixes"
echo "    - [config] for config-only changes"
echo "    - [docs] for documentation-only changes"
echo "    - [security] for emergency security patches"
echo ""
echo "  Or create a directive and use the pipeline instead."
echo ""

# Fire-and-forget violation report
AUTHOR=$(git config user.name 2>/dev/null || echo "unknown")
HASH=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
SHORT_MSG=$(echo "$COMMIT_MSG" | head -1 | cut -c1-100)
curl -s -X POST http://localhost:3333/api/pipeline-violations \
  -H 'Content-Type: application/json' \
  -d "{\"commitHash\":\"$HASH\",\"branch\":\"$BRANCH\",\"author\":\"$AUTHOR\",\"message\":\"$SHORT_MSG\",\"violationType\":\"direct_commit_main\"}" \
  >/dev/null 2>&1 &

exit 1
