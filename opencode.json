{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-chat",
  "instructions": ["CLAUDE.md", "CLAUDE.local.md"],
  "provider": {
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google Gemini",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-3.1-pro-preview": { "name": "Gemini 3.1 Pro (preview)" },
        "gemini-3.1-flash-lite": { "name": "Gemini 3.1 Flash Lite" }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/deepseek",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-chat": { "name": "DeepSeek V3" },
        "deepseek-reasoner": { "name": "DeepSeek R1" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" }
      }
    },
    "qwen": {
      "npm": "@ai-sdk/qwen",
      "name": "Qwen (Alibaba DashScope)",
      "options": {
        "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "apiKey": "{env:DASHSCOPE_API_KEY}"
      },
      "models": {
        "qwen-max": { "name": "Qwen Max" },
        "qwen-plus": { "name": "Qwen Plus" },
        "qwen3-coder-plus": { "name": "Qwen3 Coder Plus" }
      }
    },
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic",
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-haiku-4-5": { "name": "Claude Haiku 4.5" },
        "claude-sonnet-4-5": { "name": "Claude Sonnet 4.5" },
        "claude-opus-4-1": { "name": "Claude Opus 4.1" }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "deepseek/deepseek-chat": { "name": "DeepSeek V3" },
        "deepseek/deepseek-reasoner": { "name": "DeepSeek R1" },
        "deepseek/deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "qwen/qwen3-coder-plus": { "name": "Qwen3 Coder Plus" },
        "google/gemini-3.7-flash": { "name": "Gemini 3.7 Flash (small)" }
      }
    }
  }
}
