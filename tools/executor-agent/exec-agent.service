[Unit]
Description=Ozzu Executor Agent — HTTP shim for bridge → dev-01 command dispatch
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=hadmin
WorkingDirectory=/home/hadmin/exec-agent
Environment="EXEC_AGENT_HOST=10.9.0.5"
Environment="EXEC_AGENT_PORT=8888"
EnvironmentFile=/home/hadmin/exec-agent/.env
ExecStart=/usr/bin/node /home/hadmin/exec-agent/server.js
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
