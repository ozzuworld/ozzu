# ~/.ozzu-secrets — sourced by scripts/lib/infra.sh; gitignored on disk.
#
# Setup:
#   cp infra/secrets.example $HOME/.ozzu-secrets
#   chmod 600 $HOME/.ozzu-secrets
#   # then fill in real values below
#
# Override the path with: export OZZU_SECRETS=/some/other/path
# Variable names are referenced in infra/devices.json via *_secret_var fields.

# hadmin sudo password — used on dev-01, kazuma-pc, etc.
HADMIN_SUDO_PASS=''

# r605 (TP-Link Omada ER605) hadmin SSH password
R605_SSH_PASS=''

# CUCM 15 platform admin password (cucm-01)
CUCM_PLATFORM_PASS=''

# Jellyfin admin password (set during initial wizard)
JELLYFIN_ADMIN_PASS=''
